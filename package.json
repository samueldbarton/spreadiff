{
  "name": "spreadiff-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w spreadiff && npm run build -w @spreadiff/viewer",
    "dev": "npm run dev -w @spreadiff/viewer",
    "test": "npm test -w spreadiff",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "node bench/run.mjs",
    "test:browser": "node bench/browser-test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
