{
  "name": "spreadiff-lite",
  "version": "0.1.0",
  "description": "What changed between two spreadsheets, and what it moved downstream, as Markdown or JSON. No UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samueldbarton/spreadiff.git",
    "directory": "packages/spreadiff-lite"
  },
  "homepage": "https://github.com/samueldbarton/spreadiff#readme",
  "bugs": {
    "url": "https://github.com/samueldbarton/spreadiff/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "spreadiff-lite": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "xlsx",
    "diff",
    "markdown",
    "agent",
    "llm",
    "formula",
    "xlsb",
    "xls",
    "ods",
    "csv",
    "git"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "spreadiff": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
