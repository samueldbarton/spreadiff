{
  "name": "spreadiff",
  "version": "0.2.0",
  "description": "Fast, beautiful spreadsheet diffs. Canvas-rendered, virtualized, framework-agnostic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samueldbarton/spreadiff.git",
    "directory": "packages/spreadiff"
  },
  "homepage": "https://github.com/samueldbarton/spreadiff#readme",
  "bugs": {
    "url": "https://github.com/samueldbarton/spreadiff/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/worker/worker.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js",
      "default": "./dist/html/index.js"
    },
    "./xlsx": {
      "types": "./dist/core/xlsx.d.ts",
      "import": "./dist/core/xlsx.js",
      "default": "./dist/core/xlsx.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./worker/worker.js": {
      "types": "./dist/worker/worker.d.ts",
      "import": "./dist/worker/worker.js",
      "default": "./dist/worker/worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "xlsx",
    "xlsb",
    "xls",
    "ods",
    "csv",
    "diff",
    "canvas",
    "react",
    "formula",
    "review"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
