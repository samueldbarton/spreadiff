{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "spreadiff": ["../../packages/spreadiff/src/index.ts"],
      "spreadiff/*": ["../../packages/spreadiff/src/*"]
    }
  },
  "include": ["src"]
}
